{
  "name": "sarak-ui-engine-boilerplate",
  "version": "1.0.0",
  "description": "Root configuration to run Sarak Boilerplate modules",
  "scripts": {
    "dev": "npx concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "cd backend && .venv\\Scripts\\uvicorn.exe app.main:app --host 0.0.0.0 --port 1300 --reload",
    "install:frontend": "npm install --prefix frontend",
    "postinstall": "npm run install:frontend"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

